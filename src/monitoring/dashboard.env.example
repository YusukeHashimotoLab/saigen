# Environment variables of the sensor dashboard (control PC side).
#
# launch_sensor_dashboard.py reads these from the process environment; set them
# in your shell, your process supervisor, or the repository's .env (gitignored)
# if your launcher loads it. Never commit a filled-in copy: tokens and your
# lab's addresses do not belong in the repository. All are optional.

# --- Web dashboard (HTTP :8000) ----------------------------------------------

# Bind address. Default 127.0.0.1 (loopback only). Set 0.0.0.0 or a LAN IP only
# if a browser on another machine must open the dashboard, and then also set
# SENSOR_DASHBOARD_TOKEN.
#SENSOR_DASHBOARD_HOST=127.0.0.1

# Shared secret for recording control and every state-changing endpoint
# (/api/start, /api/end, /api/upload_video, /api/detect_tags, /api/zero_tags,
# /api/clear_zero, and start/stop over /ws). Unset = no token: fine for the
# loopback-only default, but then any local process can call those endpoints.
#SENSOR_DASHBOARD_TOKEN=change-me-to-a-long-random-string

# Extra Host names/IPs accepted by the Host-header and WebSocket-Origin checks.
#SENSOR_DASHBOARD_ALLOWED_HOSTS=192.0.2.10

# --- Sensor listener (TCP :50001, where the Pis push data) --------------------

# Bind address of the sensor listener. Default 0.0.0.0 (the Pi is another host).
#SENSOR_DASHBOARD_TCP_HOST=0.0.0.0

# Comma-separated IPs and/or CIDR networks of your Pis. Connections from any
# other address are closed immediately. Unset = accept any host on the LAN.
#SENSOR_DASHBOARD_PI_ALLOWED_IPS=192.0.2.21,192.0.2.22

# Shared secret the Pis must send as their first line; set the same value as
# SENSOR_AGENT_TOKEN in /etc/sensor-agent.env on every Pi.
#SENSOR_DASHBOARD_PI_TOKEN=change-me-to-another-long-random-string

# --- Misc ---------------------------------------------------------------------

#SENSOR_DASHBOARD_DATA_DIR=C:/path/to/experiment_data
#SENSOR_DASHBOARD_MAX_UPLOAD_BYTES=209715200
#SENSOR_DASHBOARD_HEADLESS=1
